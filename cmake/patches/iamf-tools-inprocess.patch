+void CopyMessage(char* destination, std::size_t capacity,
+                 std::string_view message) {
+  if (destination == nullptr || capacity == 0) return;
+  const std::size_t count = std::min(capacity - 1, message.size());
+  std::memcpy(destination, message.data(), count);
+  destination[count] = '\0';
+}
+
+std::string PathToUtf8(const std::filesystem::path& path) {
+#if defined(__cpp_char8_t)
+  const auto value = path.u8string();
+  return std::string(reinterpret_cast<const char*>(value.data()), value.size());
+#else
+  return path.u8string();
+#endif
+}
+
+class EncoderLogSink final : public absl::LogSink {
+ public:
+  explicit EncoderLogSink(const IamfToolsEncoderRunOptions& options)
+      : options_(options) {}
+
+  void Send(const absl::LogEntry& entry) override {
+    if (options_.log_callback == nullptr) return;
+    const auto text = entry.text_message_with_prefix_and_newline();
+    const std::string message(text.data(), text.size());
+    std::lock_guard<std::mutex> lock(mutex_);
+    options_.log_callback(static_cast<int>(entry.log_severity()),
+                          message.c_str(), options_.opaque);
+  }
+
+ private:
+  const IamfToolsEncoderRunOptions& options_;
+  std::mutex mutex_;
+};
+
+class ScopedLogSink final {
+ public:
+  explicit ScopedLogSink(absl::LogSink* sink) : sink_(sink) {
+    absl::AddLogSink(sink_);
+  }
+  ~ScopedLogSink() { absl::RemoveLogSink(sink_); }
+
+  ScopedLogSink(const ScopedLogSink&) = delete;
+  ScopedLogSink& operator=(const ScopedLogSink&) = delete;
+
+ private:
+  absl::LogSink* sink_;
+};
+
+std::mutex g_iamf_tools_execution_mutex;
+
+class ScopedProbeLogSilence final {
+ public:
+  ScopedProbeLogSilence()
+      : previous_min_(absl::MinLogLevel()),
+        previous_stderr_(absl::StderrThreshold()) {
+    absl::SetMinLogLevel(absl::LogSeverityAtLeast::kInfinity);
+    absl::SetStderrThreshold(absl::LogSeverityAtLeast::kInfinity);
+  }
+  ~ScopedProbeLogSilence() {
+    absl::SetMinLogLevel(previous_min_);
+    absl::SetStderrThreshold(previous_stderr_);
+  }
+
+  ScopedProbeLogSilence(const ScopedProbeLogSilence&) = delete;
+  ScopedProbeLogSilence& operator=(const ScopedProbeLogSilence&) = delete;
+
+ private:
+  absl::LogSeverityAtLeast previous_min_;
+  absl::LogSeverityAtLeast previous_stderr_;
+};
+
