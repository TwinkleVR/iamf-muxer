+extern "C" IAMF_TOOLS_ENCODER_EXPORT int iamf_tools_encoder_run(
+    const IamfToolsEncoderRunOptions* options, char* output_iamf_filename,
+    std::size_t output_iamf_filename_capacity, char* error_message,
+    std::size_t error_message_capacity) {
+  if (output_iamf_filename != nullptr && output_iamf_filename_capacity > 0) {
+    output_iamf_filename[0] = '\0';
+  }
+  if (error_message != nullptr && error_message_capacity > 0) {
+    error_message[0] = '\0';
+  }
+  const auto fail = [&](std::string_view message) {
+    CopyMessage(error_message, error_message_capacity, message);
+    return 1;
+  };
+
+  if (options == nullptr || options->user_metadata_filename == nullptr ||
+      options->input_wav_directory == nullptr ||
+      options->output_iamf_directory == nullptr) {
+    return fail("encoder options and all three input paths are required");
+  }
+  if (options->user_metadata_filename[0] == '\0' ||
+      options->input_wav_directory[0] == '\0' ||
+      options->output_iamf_directory[0] == '\0') {
+    return fail("metadata, input WAV, and output paths must not be empty");
+  }
+  if (output_iamf_filename == nullptr ||
+      output_iamf_filename_capacity == 0) {
+    return fail("output IAMF filename buffer is required");
+  }
+
+  try {
+    const std::filesystem::path metadata_path =
+        std::filesystem::u8path(options->user_metadata_filename);
+    std::ifstream metadata_file(metadata_path,
+                                std::ios::binary | std::ios::in);
+    if (!metadata_file) {
+      return fail("cannot open IAMF user metadata");
+    }
+
+    std::ostringstream metadata_stream;
+    metadata_stream << metadata_file.rdbuf();
+    const std::string serialized_metadata = metadata_stream.str();
+
+    iamf_tools_cli_proto::UserMetadata user_metadata;
+    bool parsed = false;
+    const auto extension = metadata_path.extension().string();
+    if (extension == ".binpb") {
+      parsed = user_metadata.ParseFromString(serialized_metadata);
+    } else if (extension == ".textproto" || extension == ".txtpb") {
+      parsed = google::protobuf::TextFormat::ParseFromString(
+          serialized_metadata, &user_metadata);
+    }
+    if (!parsed) {
+      return fail("cannot parse IAMF user metadata as textproto or binpb");
+    }
+
+    const std::string& output_prefix =
+        user_metadata.test_vector_metadata().file_name_prefix();
+    if (output_prefix.empty()) {
+      return fail("IAMF user metadata must set test_vector_metadata.file_name_prefix");
+    }
+
+    const std::filesystem::path output_path =
+        std::filesystem::u8path(options->output_iamf_directory) /
+        std::filesystem::u8path(output_prefix + ".iamf");
+    const std::string output_path_utf8 = PathToUtf8(output_path);
+    if (output_path_utf8.size() >= output_iamf_filename_capacity) {
+      return fail("output IAMF filename buffer is too small");
+    }
+
+    iamf_tools::EncoderRunOptions run_options;
+    if (options->cancellation_requested != nullptr) {
+      run_options.cancellation_requested = [options]() {
+        return options->cancellation_requested(options->opaque) != 0;
+      };
+    }
+
+    absl::Status status = absl::OkStatus();
+    {
+      std::lock_guard<std::mutex> execution_lock(g_iamf_tools_execution_mutex);
+      EncoderLogSink log_sink(*options);
+      ScopedLogSink scoped_log_sink(&log_sink);
+      status = iamf_tools::TestMain(user_metadata,
+                                    options->input_wav_directory,
+                                    options->output_iamf_directory,
+                                    run_options);
+    }
+    if (!status.ok()) {
+      return fail(status.ToString());
+    }
+
+    std::error_code filesystem_error;
+    if (!std::filesystem::is_regular_file(output_path, filesystem_error) ||
+        filesystem_error) {
+      return fail("official encoder completed without creating the IAMF output file");
+    }
+    std::memcpy(output_iamf_filename, output_path_utf8.c_str(),
+                output_path_utf8.size() + 1);
+    return 0;
+  } catch (const std::exception& exception) {
+    return fail(exception.what());
+  } catch (...) {
+    return fail("unknown error while running official IAMF encoder");
+  }
+}
+
+extern "C" IAMF_TOOLS_ENCODER_EXPORT int iamf_tools_probe_file(
+    const char* iamf_filename, std::size_t expected_descriptor_bytes,
+    std::uint32_t* temporal_unit_count, char* error_message,
+    std::size_t error_message_capacity) {
+  if (error_message != nullptr && error_message_capacity > 0) {
+    error_message[0] = '\0';
+  }
+  if (temporal_unit_count != nullptr) {
+    *temporal_unit_count = 0;
+  }
+  const auto fail = [&](std::string_view message, int result) {
+    CopyMessage(error_message, error_message_capacity, message);
+    return result;
+  };
+  if (iamf_filename == nullptr || iamf_filename[0] == '\0') {
+    return fail("IAMF filename is required", IAMF_TOOLS_PROBE_OPERATIONAL_ERROR);
+  }
+  try {
+    std::lock_guard<std::mutex> execution_lock(g_iamf_tools_execution_mutex);
+    ScopedProbeLogSilence silence;
+    iamf_tools::ProbeOptions options;
+    options.scan_mode = iamf_tools::ScanMode::kScanFull;
+    auto report_or = iamf_tools::ProbeFile(iamf_filename, options);
+    if (!report_or.ok()) {
+      const int result =
+          absl::IsInvalidArgument(report_or.status())
+              ? IAMF_TOOLS_PROBE_INVALID_IAMF
+              : IAMF_TOOLS_PROBE_OPERATIONAL_ERROR;
+      return fail(report_or.status().ToString(), result);
+    }
+    const auto& report = *report_or;
+    if (report.descriptor_bytes_consumed != expected_descriptor_bytes) {
+      return fail("MP4 IAMF descriptor bytes do not match the parsed IA sequence descriptors",
+                  IAMF_TOOLS_PROBE_INVALID_IAMF);
+    }
+    if (!report.temporal_unit_scan.has_value()) {
+      return fail("iamf-tools Probe did not return a temporal-unit scan",
+                  IAMF_TOOLS_PROBE_OPERATIONAL_ERROR);
+    }
+    const auto& scan = *report.temporal_unit_scan;
+    if (temporal_unit_count != nullptr) {
+      *temporal_unit_count = scan.temporal_unit_count;
+    }
+    if (scan.temporal_unit_count == 0 || scan.audio_frame_count == 0) {
+      return fail("IAMF stream has no complete temporal units or audio frames",
+                  IAMF_TOOLS_PROBE_INVALID_IAMF);
+    }
+    if (scan.audio_frame_parse_errors != 0 ||
+        scan.parameter_block_parse_errors != 0) {
+      return fail("IAMF stream contains malformed audio-frame or parameter OBUs",
+                  IAMF_TOOLS_PROBE_INVALID_IAMF);
+    }
+    if (scan.stopped_reason != "eof") {
+      const bool operational_failure =
+          scan.stopped_reason == "read_error" ||
+          scan.stopped_reason == "scan_budget_exceeded" ||
+          scan.stopped_reason == "cancelled";
+      return fail(std::string("IAMF scan stopped before end of stream: ") +
+                  scan.stopped_reason,
+                  operational_failure ? IAMF_TOOLS_PROBE_OPERATIONAL_ERROR
+                                      : IAMF_TOOLS_PROBE_INVALID_IAMF);
+    }
+    return IAMF_TOOLS_PROBE_SUCCESS;
+  } catch (const std::exception& exception) {
+    return fail(exception.what(), IAMF_TOOLS_PROBE_OPERATIONAL_ERROR);
+  } catch (...) {
+    return fail("unknown error while probing IAMF stream",
+                IAMF_TOOLS_PROBE_OPERATIONAL_ERROR);
+  }
+}
