+  set(_fdk_short_overload_guard
+    "#if !defined(_MSC_VER) && defined(__x86_64__)")
+  set(_fdk_mingw_short_overload_guard
+    "#if !defined(_MSC_VER) && defined(__x86_64__) && !defined(__MINGW64__)")
+  string(FIND "${_fdk_common_fix_contents}"
+    "${_fdk_mingw_short_overload_guard}" _fdk_mingw_guard_position)
