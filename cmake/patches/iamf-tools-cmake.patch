+    string(FIND "${_fdk_common_fix_contents}"
+      "${_fdk_short_overload_guard}" _fdk_short_guard_position)
+    if(_fdk_short_guard_position EQUAL -1)
+      message(FATAL_ERROR "Could not apply the FDK-AAC MinGW overload fix.")
+    endif()
+    string(REPLACE "${_fdk_short_overload_guard}"
+      "${_fdk_mingw_short_overload_guard}"
+      _fdk_common_fix_contents "${_fdk_common_fix_contents}")
+    file(WRITE "${_fdk_common_fix_header}" "${_fdk_common_fix_contents}")
+  endif()
+endif()
